{
  "version": 2,
  "builds": [
    {
      "src": "build/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/static/.*",
      "dest": "/$1"
    },
    {
      "src": "^/.*\\..*",
      "dest": "/$1"
    },
    {
      "src": "^/.*",
      "dest": "/index.html"
    }
  ]
}
