              "raw": "{{base_url}}/map/governorates",
              "host": ["{{base_url}}"],
              "path": ["map", "governorates"]
            }
          }
        },
        {
          "name": "Districts by Governorate",
          "request": {
            "method": "GET",
            "header": [],
