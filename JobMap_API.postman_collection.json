              "host": ["{{base_url}}"],
              "path": ["map", "governorates", ":id", "districts"]
            }
          }
        },
        {
          "name": "Location Drill Down",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/map/governorates/:id/drill-down",
              "host": ["{{base_url}}"],
              "path": ["map", "governorates", ":id", "drill-down"]
            }
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "Get Notifications",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/notifications",
              "host": ["{{base_url}}"],
              "path": ["notifications"]
            }
          }
        },
        {
          "name": "Mark as Read",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/notifications/:id/read",
              "host": ["{{base_url}}"],
              "path": ["notifications", ":id", "read"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ]
}
